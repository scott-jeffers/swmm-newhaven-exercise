[TITLE]
;;Project Title/Notes
Exercise 1 - one subcatchment draining to an outfall (50% impervious)

[OPTIONS]
FLOW_UNITS           CFS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/01/2026
END_TIME             06:00:00
DRY_DAYS             0
REPORT_STEP          00:01:00
WET_STEP             00:01:00
DRY_STEP             00:05:00
ROUTING_STEP         0:00:05
VARIABLE_STEP        0.75

[RAINGAGES]
;;Name  Format  Interval  SCF  Source
RG1  INTENSITY  0:10  1.0  TIMESERIES  Storm

[SUBCATCHMENTS]
;;Name  RainGage  Outlet  Area(ac)  %Imperv  Width(ft)  %Slope  CurbLen
S1  RG1  OUT1  5  50  500  1.0  0

[SUBAREAS]
;;Subcatch  N-Imperv  N-Perv  S-Imperv(in)  S-Perv(in)  PctZero  RouteTo
S1  0.012  0.15  0.05  0.10  25  OUTLET

[INFILTRATION]
;;Subcatch  MaxRate(in/hr)  MinRate(in/hr)  Decay(1/hr)  DryTime(days)  MaxInfil
S1  3.0  0.5  4  7  0

[OUTFALLS]
;;Name  Elevation  Type  StageData  Gated
OUT1  0  FREE  NO

[TIMESERIES]
;;Name  Time(h:mm)  Value(in/hr)
Storm  0:00  0.3
Storm  0:10  0.6
Storm  0:20  1.2
Storm  0:30  2.4
Storm  0:40  1.2
Storm  0:50  0.9
Storm  1:00  0.6
Storm  1:10  0.5
Storm  1:20  0.4
Storm  1:30  0.3
Storm  1:40  0.2
Storm  1:50  0.1
Storm  2:00  0

[REPORT]
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[MAP]
DIMENSIONS -100 -100 1100 700
Units Feet

[COORDINATES]
OUT1  900  300

[Polygons]
S1  100  100
S1  700  100
S1  700  500
S1  100  500

[SYMBOLS]
RG1  400  620
