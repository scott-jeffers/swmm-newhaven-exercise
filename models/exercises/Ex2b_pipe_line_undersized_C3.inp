Storm  1:20  0.4
Storm  1:30  0.3
Storm  1:40  0.2
Storm  1:50  0.1
Storm  2:00  0

[REPORT]
SUBCATCHMENTS ALL
NODES ALL
LINKS ALL

[PROFILES]
;;Name  Links
"Main line"  C1 C2 C3

[MAP]
DIMENSIONS -100 -300 1700 700
Units Feet

[COORDINATES]
